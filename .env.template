# ===========================================
# AI 配置（可选）
# ===========================================
# 用于公众号岗位抽取和面试准备（需在 config.yaml 启用 ai.enabled: true）
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 多 provider 自动容错（可选）：在 config.yaml 的 ai.providers 列出候选顺序后，
# 这里给每个 provider 各自的 env（名字随意，跟 config.yaml 里的 *_env 对应即可）。
# 不配置 ai.providers 时，下面这些不生效，行为与上面的单一 OPENAI_* 完全一致。
# OPENAI_API_KEY_BACKUP=
# OPENAI_BASE_URL_BACKUP=

# ===========================================
# Telegram 入口（可选）
# ===========================================
# 手机通过 Telegram bot 发链接/文本/截图 → 后端长轮询拉取 → 写入本地聊天候选（默认不入库，Web 确认后才落盘）。
# 需在 config.yaml 设 telegram.enabled: true 并填 allowed_chat_id（只处理你本人的消息）。
# token 找 @BotFather 创建 bot 获取；只进 .env，不进 config.yaml。
# TELEGRAM_BOT_TOKEN=

# ===========================================
# Docker 构建优化（推荐配置）
# ===========================================
# PyPI 镜像源（解决 pip install 超时问题）
# 阿里云镜像（推荐，国内稳定）
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# 或使用清华镜像：https://pypi.tuna.tsinghua.edu.cn/simple
# 或使用官方源：https://pypi.org/simple

# NPM 镜像源
NPM_REGISTRY=https://registry.npmmirror.com
# 或使用官方源：https://registry.npmjs.org

# ===========================================
# 运行时配置（可选覆盖）
# ===========================================
# JOB_ONE_STOP_DATABASE_URL=sqlite:///./data/job_one_stop/job_one_stop.sqlite3
# JOB_ONE_STOP_CONFIG=./config.yaml
# JOB_ONE_STOP_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# JOB_ONE_STOP_OPENCLI_SERVER_ENABLED=false
# 个人操作仓库（只读）；必须使用当前运行环境可识别的绝对路径
# Windows 示例：JOB_ONE_STOP_CONTEXT_REPO_PATH=D:\path\to\personal-context
# WSL 示例：JOB_ONE_STOP_CONTEXT_REPO_PATH=/mnt/d/path/to/personal-context
# JOB_ONE_STOP_CONTEXT_REPO_PATH=
# HOST_PORT=8000
# PORT=8000
